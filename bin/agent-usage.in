#!/usr/bin/env bash
# The agent-usage command. @PYTHON@ and @APP_DIR@ are filled in by install.sh
# and build-deb.sh.
set -euo pipefail
APP="@APP_DIR@"
PY="@PYTHON@"

case "${1:-}" in
  --daemon) shift; exec "$PY" "$APP/daemon.py" "$@" ;;
  -h|--help)
    cat <<'EOF'
usage: agent-usage [--json | --daemon]

  (no option)   print each coding agent's quota and token usage
  --json        the same reading as JSON
  --daemon      run the collector that keeps ~/.cache/agent-usage/state.json
                current for the GNOME extension (normally started by systemd)
EOF
    exit 0 ;;
esac
exec "$PY" "$APP/cli.py" "$@"
